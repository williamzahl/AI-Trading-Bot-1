//@version=6
indicator("Pepperstone NAS100 / US500 5M SMT", overlay=true, max_lines_count=500, max_labels_count=500, dynamic_requests=true, max_bars_back=500)
// CFD version of the MNQ/MES 5M SMT indicator, built for Pepperstone's feed so
// the TradingView signal matches the prices in the Pepperstone MT5 account.
// Use it on a PEPPERSTONE:NAS100 or PEPPERSTONE:US500 chart (5M or lower for drawings).
// Native 5-minute NAS100/US500 data is requested once per symbol. Chart symbol
// detection is deliberately kept outside the request expressions so it cannot
// accidentally resolve to NAS100 while evaluating a requested NAS100 context.
//====================================================
// Settings
//====================================================
string GROUP_SYMBOLS = "Symbols"
string nasSymbolInput = input.symbol("PEPPERSTONE:NAS100", "Nasdaq 100 CFD", group=GROUP_SYMBOLS)
string spxSymbolInput = input.symbol("PEPPERSTONE:US500", "S&P 500 CFD", group=GROUP_SYMBOLS,
     tooltip="The chart you put the indicator on always supplies its own leg, so lines sit exactly on that chart's candles. These inputs set the other leg. Keep both pointing at the same symbols you trade in MT5.")
int SOURCE_SECONDS = 300
int SOURCE_MS = SOURCE_SECONDS * 1000
int REFERENCE_CAPACITY = 32
string GROUP_DETECTION = "5M SMT Detection"
int drawingPivotStrength = input.int(3, "SMT Drawing Pivot", minval=1, maxval=10, group=GROUP_DETECTION,
     tooltip="5M candles on each side of a swing high/low. 3 = the swing must hold for 15 minutes on both sides.")
int majorLookbackBars = input.int(24, "Major swing: lowest low / highest high of last N 5M bars", minval=0, maxval=300, group=GROUP_DETECTION,
     tooltip="A swing only counts if it is the lowest low (or highest high) of the previous N 5M candles. 24 = 2 hours. Removes small swings in the middle of a range. 0 = off.")
float minSwingATR = input.float(1.0, "Major swing: minimum move away (x ATR)", minval=0.0, maxval=10.0, step=0.1, group=GROUP_DETECTION,
     tooltip="Price must have moved at least this many ATR(14) away from the swing before it is swept. Removes levels that sit just next to each other. 0 = off.")
int alertPivotStrength = input.int(0, "Alert Pivot", minval=0, maxval=10, group=GROUP_DETECTION,
     tooltip="Retained for settings compatibility. Alerts now use the validated Drawing Pivot event so each drawn SMT and its alert share the same pivot pair.")
int swingToleranceBars = input.int(1, "Swing matching tolerance (5M bars)", minval=0, maxval=5, group=GROUP_DETECTION)
int maxSwingDistanceBars = input.int(100, "Maximum distance from matched swing (5M bars)", minval=1, maxval=1000, group=GROUP_DETECTION)
int pivotQueueCapacity = math.min(32, swingToleranceBars + drawingPivotStrength + 2)
int alertPivotQueueCapacity = math.min(32, swingToleranceBars + alertPivotStrength + 2)
float minimumStrength = input.float(35.0, "Minimum SMT strength (%)", minval=0.0, maxval=100.0, step=1.0, group=GROUP_DETECTION)
int minimumDivergenceTicks = input.int(2, "Minimum divergence distance (sweeper ticks)", minval=0, maxval=10000, group=GROUP_DETECTION,
     tooltip="Measured in the sweeping symbol's own tick size. Only a noise floor: the real size check is the ATR setting below, which is fair to both NAS100 and US500 (1 point on US500 is a much bigger move than 1 point on NAS100).")
float minSweepATR = input.float(0.05, "Minimum sweep beyond the level (x ATR of the sweeping market)", minval=0.0, maxval=5.0, step=0.01, group=GROUP_DETECTION,
     tooltip="How far the sweeping market must trade beyond its old high/low, in its own 5M ATR. 0.05 = about 1.5 points on NAS100 or 0.25 points on US500.")
bool useMinimumPercentDifference = input.bool(false, "Use minimum percentage difference", group=GROUP_DETECTION)
float minimumPercentDifference = input.float(0.10, "Minimum percentage difference (%)", minval=0.0, maxval=10.0, step=0.01, group=GROUP_DETECTION)
string GROUP_LEVELS = "Key levels (only logical SMTs)"
int rangeBars = input.int(144, "Not mid-range: range window (5M bars)", minval=0, maxval=500, group=GROUP_LEVELS,
     tooltip="The swing high must sit in the top part (swing low in the bottom part) of the high-low range of the last N 5M candles. 144 = 12 hours. Removes swings in the middle of the day's range. 0 = off.")
float rangeEdgePct = input.float(40.0, "Not mid-range: swing must be in top/bottom % of range", minval=5.0, maxval=100.0, step=5.0, group=GROUP_LEVELS,
     tooltip="40 = a swing high must be in the top 40% of the range, a swing low in the bottom 40%. 100 = off.")
float magnetATR = input.float(0.5, "Skip if an untaken key level is within (x ATR) beyond the SMT", minval=0.0, maxval=5.0, step=0.1, group=GROUP_LEVELS,
     tooltip="Key levels: previous day high/low, last Asia / London / New York session high/low that has not been taken yet, and today's high/low. If such a level sits just above a bearish SMT (or just below a bullish one) on NAS100, price will probably run it first, so the SMT is skipped. Sessions in New York time: Asia 18:00-02:00, London 02:00-08:30, New York 08:30-17:00. 0 = off.")
string GROUP_ALERTS = "Alerts"
bool enableAlerts = input.bool(true, "Enable SMT alerts", group=GROUP_ALERTS,
     tooltip="Alerts use confirmed 5M source bars on supported time-based chart timeframes. Drawings are shown only on charts at or below 5 minutes.")
bool enableBullishAlerts = input.bool(true, "Enable bullish alerts", group=GROUP_ALERTS)
bool enableBearishAlerts = input.bool(true, "Enable bearish alerts", group=GROUP_ALERTS)
int candleClosesBeforeAlert = input.int(0, "Additional 5M candles before alert", minval=0, maxval=10, group=GROUP_ALERTS,
     tooltip="0 alerts at the close of the 5M candle that confirms the SMT. 1 alerts at the close of the next 5M candle, 2 at the close of the second following 5M candle, and so on.")
int pendingAlertCapacity = (candleClosesBeforeAlert + 1) * 2
string GROUP_DRAWINGS = "Drawings"
bool showHistoricalLines = input.bool(true, "Show historical SMT lines", group=GROUP_DRAWINGS)
bool showBullishLines = input.bool(true, "Show bullish SMT lines", group=GROUP_DRAWINGS)
bool showBearishLines = input.bool(true, "Show bearish SMT lines", group=GROUP_DRAWINGS)
bool showOnlyLatest = input.bool(false, "Show only the latest SMT", group=GROUP_DRAWINGS)
int maximumHistoricalSignals = input.int(10, "Maximum Historical SMT Signals",
     options=[10, 20, 30, 50, 100], group=GROUP_DRAWINGS,
     tooltip="Combined bullish and bearish history. This also selects the 5M source lookback: 3000 / 4000 / 5000 / 6000 / 8000 candles (extra history so the trend EMAs are warmed up before the first SMT) for 10 / 20 / 30 / 50 / 100 signals.")
color bullishColor = input.color(#00E676, "Bullish color", group=GROUP_DRAWINGS)
color bearishColor = input.color(#FF1744, "Bearish color", group=GROUP_DRAWINGS)
int lineWidth = input.int(2, "Line width", minval=1, maxval=5, group=GROUP_DRAWINGS)
int lineTransparency = input.int(0, "Line transparency", minval=0, maxval=100, group=GROUP_DRAWINGS)
string GROUP_CFD = "CFD session (daily break)"
string blockSession = input.session("1655-1815", "No-alert window (New York time)", group=GROUP_CFD,
     tooltip="Pepperstone US index CFDs stop for about an hour every day (17:00-18:00 New York time, around 23:00-00:00 Norway time), and spreads are wide around it. SMT events confirmed inside this window are drawn but never alerted. Uses New York time so it follows US daylight saving automatically.")
bool resetAcrossBreak = input.bool(true, "Reset swing references across market breaks", group=GROUP_CFD,
     tooltip="On = when the 5M feed has a gap (daily break, weekend, holiday), all open swing references and unmatched pivots are cleared, so a swing from before the break is never compared with price after it.")
int gapResetMinutes = input.int(15, "Gap that counts as a break (minutes)", minval=10, maxval=240, group=GROUP_CFD)
string GROUP_WEBHOOK = "Webhook"
string webhookSecret = input.string("", "Webhook secret", group=GROUP_WEBHOOK,
     tooltip="Leave empty (recommended) and put the key in the webhook URL as ?key=... instead. If filled in, it must match WEBHOOK_SECRET on Render.")
string indicatorId = input.string("SMT_PEPPERSTONE_5M", "Indicator id", group=GROUP_WEBHOOK)
string GROUP_DEBUG = "Debug"
bool debugMode = input.bool(false, "Enable debug mode", group=GROUP_DEBUG,
     tooltip="Shows a table with the latest status, and small labels on the chart: 'ref' = swing accepted as SMT level, 'H x'/'L x' = swing thrown away (with reason), and a label with the reason when a sweep happened but the SMT was rejected.")
int chartSeconds = timeframe.in_seconds()
string chartTicker = str.upper(syminfo.ticker)
// Ticker part of an input such as "PEPPERSTONE:NAS100.P" -> "NAS100.P".
f_tickerOf(string symbolId) =>
    array<string> parts = str.split(str.upper(symbolId), ":")
    array.size(parts) > 0 ? array.get(parts, array.size(parts) - 1) : ""
bool chartIsNAS = chartTicker == f_tickerOf(nasSymbolInput) or str.contains(chartTicker, "NAS100") or str.contains(chartTicker, "US100") or str.contains(chartTicker, "USTEC")
bool chartIsSPX = chartTicker == f_tickerOf(spxSymbolInput) or str.contains(chartTicker, "US500") or str.contains(chartTicker, "SPX500")
// The chart leg is always the chart's own symbol. Drawing with prices from a
// different symbol (e.g. US500.P data on a US500 chart) offsets the lines.
string nasSymbol = chartIsNAS and not chartIsSPX ? syminfo.prefix + ":" + syminfo.ticker : nasSymbolInput
string spxSymbol = chartIsSPX and not chartIsNAS ? syminfo.prefix + ":" + syminfo.ticker : spxSymbolInput
string nasTicker = f_tickerOf(nasSymbol)
string spxTicker = f_tickerOf(spxSymbol)
bool supportedChart = (chartIsNAS or chartIsSPX) and not (chartIsNAS and chartIsSPX)
bool chartIsPepperstone = str.upper(syminfo.prefix) == "PEPPERSTONE"
bool drawingsVisible = not na(chartSeconds) and chartSeconds <= SOURCE_SECONDS
bool needBullishEngine = debugMode or (enableAlerts and enableBullishAlerts) or
     (drawingsVisible and showHistoricalLines and showBullishLines)
bool needBearishEngine = debugMode or (enableAlerts and enableBearishAlerts) or
     (drawingsVisible and showHistoricalLines and showBearishLines)
// Higher chart timeframes consume confirmed 5M intrabars.
// Drawings remain limited to charts at or below 5 minutes.
bool canRunEngine = supportedChart and (needBullishEngine or needBearishEngine)
bool drawUsingNASPrices = chartIsNAS
if barstate.isfirst and not supportedChart
    runtime.error("Use this indicator on a PEPPERSTONE:NAS100 or PEPPERSTONE:US500 chart.")
if barstate.isfirst and na(chartSeconds)
    runtime.error("Use this indicator on a time-based chart.")
//====================================================
// Trend-bias (24t) for webhook/Telegram-filter
//====================================================
string GROUP_BIAS = "Trend bias (24h)"
float biasThresholdPct = input.float(0.5, "Trend threshold 24h (%)", minval=0.0, maxval=10.0, step=0.1, group=GROUP_BIAS,
     tooltip="Change over ~24h on NAS100 (hourly bars). Above +threshold = UP, below -threshold = DOWN, otherwise NONE.")
int biasLookbackBars = input.int(23, "Bias lookback (hourly bars)", minval=1, maxval=200, group=GROUP_BIAS,
     tooltip="The CFDs trade about 23 hours a day, so 23 hourly bars is roughly 24 hours.")
string trendMode = input.string("Hide counter-trend", "Trend filter for SMT lines and alerts",
     options=["Hide counter-trend", "Grey counter-trend", "Off"], group=GROUP_BIAS,
     tooltip="Hide counter-trend = a bullish SMT in a DOWN trend or a bearish SMT in an UP trend is neither drawn nor alerted. Grey = drawn in grey (alert follows the INFO setting below). SMTs with no trend (NONE) are drawn in grey. Off = everything drawn in normal colors.")
int trendLookbackBars = input.int(12, "With-trend swing: pullback window (bars before the swing)", minval=1, maxval=300, group=GROUP_BIAS,
     tooltip="In a DOWN trend a swing high is a lower high, so it is NOT required to be the highest high. Instead price must have rallied into it by at least the ATR amount below, measured from the lowest low of this many bars before the swing (12 = 1 hour on 5M). Same for swing lows in an UP trend. The mid-range filter is skipped for these swings.")
float trendPullbackATR = input.float(1.0, "With-trend swing: minimum pullback into the swing (x ATR)", minval=0.0, maxval=10.0, step=0.1, group=GROUP_BIAS)
string trendSource = input.string("Intraday EMA", "Trend source",
     options=["Intraday EMA", "24h change", "24h change, else intraday"], group=GROUP_BIAS,
     tooltip="Intraday EMA = NAS100 fast EMA above slow EMA on the source candles is UP, below is DOWN (follows the trend you see on the chart today). 24h change = the old rule (NAS100 change over ~24h vs the threshold above). This trend decides which SMTs are shown, which are sent as trend-aligned (traded by Render), and which swings count as with-trend pullbacks.")
int trendFastLen = input.int(50, "Intraday trend: fast EMA (source candles)", minval=2, maxval=500, group=GROUP_BIAS)
int trendSlowLen = input.int(200, "Intraday trend: slow EMA (source candles)", minval=3, maxval=1000, group=GROUP_BIAS)
color greyColor = input.color(color.gray, "Counter-trend / no-trend color", group=GROUP_BIAS)
bool sendCounterTrend = input.bool(true, "Also alert counter-trend SMT (sent as INFO)", group=GROUP_BIAS,
     tooltip="Off = bearish SMT in an UP trend and bullish SMT in a DOWN trend (and all SMT with no trend) are not alerted at all.")
[biasNowPrice, biasRefPrice] = request.security(nasSymbol, "60", [close, close[biasLookbackBars]], lookahead=barmerge.lookahead_off)
float bias24Pct = not na(biasRefPrice) and biasRefPrice != 0 ? 100.0 * (biasNowPrice - biasRefPrice) / biasRefPrice : na
string bias24State = na(bias24Pct) ? "NONE" : bias24Pct >= biasThresholdPct ? "UP" : bias24Pct <= -biasThresholdPct ? "DOWN" : "NONE"
f_biasText() =>
    string pctText = na(bias24Pct) ? "n/a" : (bias24Pct >= 0 ? "+" : "") + str.tostring(bias24Pct, "#.##") + "%"
    " | 24t: " + pctText + " | bias=" + bias24State
varip int realtimeStart = na
if barstate.isrealtime and na(realtimeStart)
    realtimeStart := timenow
//====================================================
// Types and source helpers
//====================================================
type PivotPoint
    int pivotTime
    float price
type SourceBundle
    float highValue
    float lowValue
    float closeValue
    int sourceTime
    int sourceClose
    float tickSize
    float pivotHigh
    int pivotHighTime
    float pivotLow
    int pivotLowTime
    float alertPivotHigh
    int alertPivotHighTime
    float alertPivotLow
    int alertPivotLowTime
    float atrValue
    // Previous closed 5M candle ([1]) for catch-up of a missed closing execution.
    float prevHighValue
    float prevLowValue
    float prevCloseValue
    int prevSourceTime
    int prevSourceClose
    float prevPivotHigh
    int prevPivotHighTime
    float prevPivotLow
    int prevPivotLowTime
    float prevAtrValue
    // Nearest two untaken key levels above the candle high / below the candle low.
    float magnetAbove1 = na
    float magnetAbove2 = na
    float magnetBelow1 = na
    float magnetBelow2 = na
    float prevMagnetAbove1 = na
    float prevMagnetAbove2 = na
    float prevMagnetBelow1 = na
    float prevMagnetBelow2 = na
    int trendDir = 0
    int prevTrendDir = 0
    // Debug: swing that existed but was thrown away by a filter (1 = lookback, 2 = mid-range).
    int highRejectCode = 0
    int highRejectTime = na
    float highRejectPrice = na
    int lowRejectCode = 0
    int lowRejectTime = na
    float lowRejectPrice = na
type PendingSmt
    string eventId
    bool bullish
    string sourceTimeframe
    int confirmationBarTime
    float confirmationClose
    int completedCandlesSinceConfirmation
    bool alertSent
    string sweeper = ""
    float smtLevel = na  // SMT extreme on the chart symbol: lowest of swing low and sweep low (bullish), highest of swing high and sweep high (bearish)
    string trend = "NONE"  // trend state at the SMT candle (UP / DOWN / NONE)
type SourceCandle
    int sourceTime
    int sourceClose
    float highValue
    float lowValue
type DrawSmt
    bool bullish
    bool muted
    int eventId
    int x1
    float y1
    int x2
    float y2
type SweepReference
    int nasTime
    float nasPrice
    int spxTime
    float spxPrice
    int activationClose
    bool nasTaken = false
    bool spxTaken = false
    bool divergedNow = false
// Keeps the two nearest levels above (or below) refPrice.
f_nearest2(float n1, float n2, float level, float refPrice, bool above) =>
    float best1 = n1
    float best2 = n2
    bool valid = not na(level) and not na(refPrice) and (above ? level > refPrice : level < refPrice)
    if valid
        if na(best1) or (above ? level < best1 : level > best1)
            best2 := best1
            best1 := level
        else if level != best1 and (na(best2) or (above ? level < best2 : level > best2))
            best2 := level
    [best1, best2]
// This runs inside the explicit symbol/"5" request. No chart timeframe data
// and no 1-minute data enter the pivot calculation. The host only consumes a
// source candle after its close timestamp has passed.
f_sourceBundle(int drawingStrength, int alertStrength, bool includeHighPivots, bool includeLowPivots) =>
    float swingHigh = na
    float swingLow = na
    float alertSwingHigh = na
    float alertSwingLow = na
    int alertLeftBars = math.max(1, alertStrength)
    if includeHighPivots
        swingHigh := ta.pivothigh(high, drawingStrength, drawingStrength)
        alertSwingHigh := ta.pivothigh(high, alertLeftBars, alertStrength)
    if includeLowPivots
        swingLow := ta.pivotlow(low, drawingStrength, drawingStrength)
        alertSwingLow := ta.pivotlow(low, alertLeftBars, alertStrength)
    // Major swing filter: the pivot must be the extreme of the last N candles
    // before it (plus its own pivot window).
    // Trend of this market over ~24h (same idea as the webhook bias): a swing
    // low in an UP trend (or a swing high in a DOWN trend) is a with-trend
    // pullback and gets the looser pullback lookback instead.
    float trendRefClose = close[math.max(1, biasLookbackBars * 12)]
    float trendPct = not na(trendRefClose) and trendRefClose != 0 ? 100.0 * (close - trendRefClose) / trendRefClose : na
    bool trendUp = not na(trendPct) and trendPct >= biasThresholdPct
    bool trendDown = not na(trendPct) and trendPct <= -biasThresholdPct
    float emaFast = ta.ema(close, trendFastLen)
    float emaSlow = ta.ema(close, trendSlowLen)
    int intradayDir = na(emaFast) or na(emaSlow) ? 0 : emaFast > emaSlow ? 1 : emaFast < emaSlow ? -1 : 0
    int dayDir = trendUp ? 1 : trendDown ? -1 : 0
    int trendDirNow = trendSource == "Intraday EMA" ? intradayDir : trendSource == "24h change" ? dayDir : (dayDir != 0 ? dayDir : intradayDir)
    bool lowWithTrend = trendDirNow == 1 and trendMode != "Off"
    bool highWithTrend = trendDirNow == -1 and trendMode != "Off"
    float majorLow = ta.lowest(low, drawingStrength + majorLookbackBars + 1)
    float majorHigh = ta.highest(high, drawingStrength + majorLookbackBars + 1)
    // Extremes of the window just before the swing candle, for the with-trend pullback test.
    float preSwingLow = ta.lowest(low, trendLookbackBars)[drawingStrength + 1]
    float preSwingHigh = ta.highest(high, trendLookbackBars)[drawingStrength + 1]
    float pivotATR = ta.atr(14)
    float rawSwingHigh = swingHigh
    float rawSwingLow = swingLow
    int highRejectCode = 0
    int lowRejectCode = 0
    if not na(swingLow)
        if lowWithTrend
            // Higher low in an UP trend: price must have dropped into it.
            if trendPullbackATR > 0 and (na(preSwingHigh) or na(pivotATR) or preSwingHigh - swingLow < trendPullbackATR * pivotATR)
                swingLow := na
                lowRejectCode := 3
        else if majorLookbackBars > 0 and swingLow > majorLow
            swingLow := na
            lowRejectCode := 1
    if not na(swingHigh)
        if highWithTrend
            // Lower high in a DOWN trend: price must have rallied into it.
            if trendPullbackATR > 0 and (na(preSwingLow) or na(pivotATR) or swingHigh - preSwingLow < trendPullbackATR * pivotATR)
                swingHigh := na
                highRejectCode := 3
        else if majorLookbackBars > 0 and swingHigh < majorHigh
            swingHigh := na
            highRejectCode := 1
    // Not mid-range: the swing must sit near the top (high) or bottom (low)
    // of the last rangeBars candles.
    float rangeTop = ta.highest(high, math.max(1, rangeBars))
    float rangeBottom = ta.lowest(low, math.max(1, rangeBars))
    float rangeSize = rangeTop - rangeBottom
    if rangeBars > 0 and rangeEdgePct < 100 and not na(rangeSize) and rangeSize > 0
        if not highWithTrend and not na(swingHigh) and (swingHigh - rangeBottom) / rangeSize < 1.0 - rangeEdgePct / 100.0
            swingHigh := na
            highRejectCode := 2
        if not lowWithTrend and not na(swingLow) and (rangeTop - swingLow) / rangeSize < 1.0 - rangeEdgePct / 100.0
            swingLow := na
            lowRejectCode := 2
    // Key levels on the New York clock. Trading day starts with Asia (18:00 NY).
    int nyMinute = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    int sessionNow = nyMinute >= 18 * 60 or nyMinute < 2 * 60 ? 0 : nyMinute < 8 * 60 + 30 ? 1 : 2
    var int sessionId = -1
    var float sessHigh = na
    var float sessLow = na
    var float dayHigh = na
    var float dayLow = na
    var float pdHigh = na
    var float pdLow = na
    var float asiaHigh = na
    var float asiaLow = na
    var float lonHigh = na
    var float lonLow = na
    var float nyHigh = na
    var float nyLow = na
    if sessionNow != sessionId
        if sessionId == 0
            asiaHigh := sessHigh
            asiaLow := sessLow
        else if sessionId == 1
            lonHigh := sessHigh
            lonLow := sessLow
        else if sessionId == 2
            nyHigh := sessHigh
            nyLow := sessLow
        if sessionNow == 0
            pdHigh := dayHigh
            pdLow := dayLow
            dayHigh := na
            dayLow := na
        sessionId := sessionNow
        sessHigh := na
        sessLow := na
    // A completed level that price trades through is taken and no longer a magnet.
    if not na(pdHigh) and high > pdHigh
        pdHigh := na
    if not na(pdLow) and low < pdLow
        pdLow := na
    if not na(asiaHigh) and high > asiaHigh
        asiaHigh := na
    if not na(asiaLow) and low < asiaLow
        asiaLow := na
    if not na(lonHigh) and high > lonHigh
        lonHigh := na
    if not na(lonLow) and low < lonLow
        lonLow := na
    if not na(nyHigh) and high > nyHigh
        nyHigh := na
    if not na(nyLow) and low < nyLow
        nyLow := na
    // Running session / day extremes from earlier candles count only if above
    // (below) this candle, so they are checked before this candle is added.
    float magA1 = na
    float magA2 = na
    float magB1 = na
    float magB2 = na
    [a1, a2] = f_nearest2(magA1, magA2, pdHigh, high, true)
    [a3, a4] = f_nearest2(a1, a2, asiaHigh, high, true)
    [a5, a6] = f_nearest2(a3, a4, lonHigh, high, true)
    [a7, a8] = f_nearest2(a5, a6, nyHigh, high, true)
    [a9, a10] = f_nearest2(a7, a8, sessHigh, high, true)
    [a11, a12] = f_nearest2(a9, a10, dayHigh, high, true)
    [b1, b2] = f_nearest2(magB1, magB2, pdLow, low, false)
    [b3, b4] = f_nearest2(b1, b2, asiaLow, low, false)
    [b5, b6] = f_nearest2(b3, b4, lonLow, low, false)
    [b7, b8] = f_nearest2(b5, b6, nyLow, low, false)
    [b9, b10] = f_nearest2(b7, b8, sessLow, low, false)
    [b11, b12] = f_nearest2(b9, b10, dayLow, low, false)
    sessHigh := na(sessHigh) ? high : math.max(sessHigh, high)
    sessLow := na(sessLow) ? low : math.min(sessLow, low)
    dayHigh := na(dayHigh) ? high : math.max(dayHigh, high)
    dayLow := na(dayLow) ? low : math.min(dayLow, low)
    int swingHighTime = not na(swingHigh) ? time[drawingStrength] : na
    int swingLowTime = not na(swingLow) ? time[drawingStrength] : na
    int alertSwingHighTime = not na(alertSwingHigh) ? time[alertStrength] : na
    int alertSwingLowTime = not na(alertSwingLow) ? time[alertStrength] : na
    float bundleHigh = high
    float bundleLow = low
    float atrValue = ta.atr(14)
    SourceBundle.new(bundleHigh, bundleLow,
         close, time, time_close, syminfo.mintick,
         swingHigh, swingHighTime, swingLow, swingLowTime, alertSwingHigh, alertSwingHighTime, alertSwingLow, alertSwingLowTime, atrValue,
         bundleHigh[1], bundleLow[1], close[1], time[1], time_close[1],
         swingHigh[1], swingHighTime[1], swingLow[1], swingLowTime[1], atrValue[1],
         a11, a12, b11, b12, a11[1], a12[1], b11[1], b12[1], trendDirNow, nz(trendDirNow[1]),
         highRejectCode, highRejectCode > 0 ? time[drawingStrength] : na, highRejectCode > 0 ? rawSwingHigh : na,
         lowRejectCode, lowRejectCode > 0 ? time[drawingStrength] : na, lowRejectCode > 0 ? rawSwingLow : na)
// calc_bars_count is a compile-time constant in Pine. These small wrappers let
// the user-selected signal cap choose a matching, bounded 5M history window.
f_request900(string tickerId, int drawingStrength, int alertStrength, bool includeHighPivots, bool includeLowPivots) =>
    request.security(tickerId, "5", f_sourceBundle(drawingStrength, alertStrength, includeHighPivots, includeLowPivots), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, calc_bars_count=3000)
