f_pushPivot(array<PivotPoint> queue, float price, int pivotTime, int capacity) =>
    if not na(price) and not na(pivotTime)
        array.push(queue, PivotPoint.new(pivotTime, price))
        while array.size(queue) > capacity
            array.shift(queue)
    true
f_pushSourceCandle(array<SourceCandle> candles, SourceCandle candle, int capacity) =>
    array.push(candles, candle)
    while array.size(candles) > capacity
        array.shift(candles)
    true
// Reject the SMT if the straight line between the confirmed wick pivots
// intersects any intervening source candle range on this instrument.
f_segmentClear(array<SourceCandle> candles, int startTime, float startPrice,
     int endTime, float endPrice, bool highSegment) =>
    bool clear = not na(startTime) and not na(endTime) and not na(startPrice) and
         not na(endPrice) and endTime > startTime and array.size(candles) > 0
    int count = array.size(candles)
    if clear
        SourceCandle oldest = array.get(candles, 0)
        SourceCandle newest = array.get(candles, count - 1)
        if oldest.sourceTime > startTime or newest.sourceTime < endTime
            clear := false
    bool startEndpointFound = false
    bool endEndpointFound = false
    int index = 0
    while clear and index < count
        SourceCandle candle = array.get(candles, index)
        if candle.sourceTime > endTime
            index := count
        else
            if candle.sourceTime == startTime
                startEndpointFound := highSegment ? candle.highValue == startPrice : candle.lowValue == startPrice
            if candle.sourceTime == endTime
                endEndpointFound := highSegment ? candle.highValue == endPrice : candle.lowValue == endPrice
            if candle.sourceTime > startTime and candle.sourceTime < endTime
                if candle.sourceClose > endTime
                    clear := false
                else
                    float fractionOpen = float(candle.sourceTime - startTime) / float(endTime - startTime)
                    float fractionClose = float(candle.sourceClose - startTime) / float(endTime - startTime)
                    float lineAtOpen = startPrice + (endPrice - startPrice) * fractionOpen
                    float lineAtClose = startPrice + (endPrice - startPrice) * fractionClose
                    float segmentFloor = math.min(lineAtOpen, lineAtClose)
                    float segmentCeiling = math.max(lineAtOpen, lineAtClose)
                    if highSegment and candle.highValue >= segmentFloor
                        clear := false
                    if not highSegment and candle.lowValue <= segmentCeiling
                        clear := false
        index += 1
    clear and startEndpointFound and endEndpointFound
f_debugTime(int sourceTime) =>
    na(sourceTime) ? "na" : str.format_time(sourceTime, "MM-dd HH:mm", "Europe/Oslo")
// FIFO, one-to-one time matching. The queues are bounded to 32 pivots and this
// function runs only once for a newly closed, synchronized 5M candle.
f_takeMatchedPivot(array<PivotPoint> nasQueue, array<PivotPoint> spxQueue,
     int toleranceMs, int nowTime, int maxQueueAgeMs) =>
    bool matched = false
    int nasTime = na
    float nasPrice = na
    int spxTime = na
    float spxPrice = na
    int comparedNASTime = na
    int comparedSPXTime = na
    bool searching = true
    while searching
        int nasCount = array.size(nasQueue)
        int spxCount = array.size(spxQueue)
        if nasCount > 0 and spxCount > 0
            PivotPoint nasPivot = array.get(nasQueue, 0)
            PivotPoint spxPivot = array.get(spxQueue, 0)
            comparedNASTime := nasPivot.pivotTime
            comparedSPXTime := spxPivot.pivotTime
            if math.abs(nasPivot.pivotTime - spxPivot.pivotTime) <= toleranceMs
                nasPivot := array.shift(nasQueue)
                spxPivot := array.shift(spxQueue)
                nasTime := nasPivot.pivotTime
                nasPrice := nasPivot.price
                spxTime := spxPivot.pivotTime
                spxPrice := spxPivot.price
                matched := true
                searching := false
            else if nasPivot.pivotTime < spxPivot.pivotTime
                array.shift(nasQueue)
            else
                array.shift(spxQueue)
        else
            bool removedOld = false
            if nasCount > 0
                PivotPoint oldestNAS = array.get(nasQueue, 0)
                if not na(nowTime) and nowTime > oldestNAS.pivotTime + maxQueueAgeMs
                    array.shift(nasQueue)
                    removedOld := true
            if spxCount > 0
                PivotPoint oldestSPX = array.get(spxQueue, 0)
                if not na(nowTime) and nowTime > oldestSPX.pivotTime + maxQueueAgeMs
                    array.shift(spxQueue)
                    removedOld := true
            if not removedOld
                searching := false
    [matched, nasTime, nasPrice, spxTime, spxPrice, comparedNASTime, comparedSPXTime]
// Builds the previous closed 5M candle from the [1] fields of a requested bundle.
// It lets the host catch up a closed source candle whose closing execution was
// missed. lastSourceClose still guarantees each candle is processed only once.
f_previousBundle(SourceBundle source) =>
    SourceBundle previous = na
    if not na(source)
        if not na(source.prevSourceTime) and not na(source.prevSourceClose)
            previous := SourceBundle.new(highValue=source.prevHighValue, lowValue=source.prevLowValue,
                 closeValue=source.prevCloseValue, sourceTime=source.prevSourceTime, sourceClose=source.prevSourceClose,
                 tickSize=source.tickSize, pivotHigh=source.prevPivotHigh, pivotHighTime=source.prevPivotHighTime,
                 pivotLow=source.prevPivotLow, pivotLowTime=source.prevPivotLowTime, atrValue=source.prevAtrValue,
                 magnetAbove1=source.prevMagnetAbove1, magnetAbove2=source.prevMagnetAbove2,
                 magnetBelow1=source.prevMagnetBelow1, magnetBelow2=source.prevMagnetBelow2,
                 trendDir=source.prevTrendDir)
    previous
// Most extreme high (highSide) or low after afterTime, earliest candle on ties.
f_extremeAfter(array<SourceCandle> candles, int afterTime, bool highSide) =>
    int bestTime = na
    float bestPrice = na
    int index = 0
    while index < array.size(candles)
        SourceCandle candle = array.get(candles, index)
        if candle.sourceTime > afterTime
            float price = highSide ? candle.highValue : candle.lowValue
            if not na(price) and (na(bestPrice) or (highSide ? price > bestPrice : price < bestPrice))
                bestPrice := price
                bestTime := candle.sourceTime
        index += 1
    [bestTime, bestPrice]
// High or low of the stored source candle that opened at atTime.
f_candlePrice(array<SourceCandle> candles, int atTime, bool highSide) =>
    float price = na
    int index = array.size(candles) - 1
    while index >= 0
        SourceCandle candle = array.get(candles, index)
        if candle.sourceTime == atTime
            price := highSide ? candle.highValue : candle.lowValue
            index := -1
        else if candle.sourceTime < atTime
            index := -1
        else
            index -= 1
    price
// Registers a matched, confirmed pivot pair as an active sweep reference.
// Taken flags include every closed candle after each market's own pivot up to
// and including the activation candle, so a sweep that happened before the
// pair could be confirmed is evaluated on the activation candle.
f_registerReference(array<SweepReference> refs, array<SourceCandle> nasCandles, array<SourceCandle> spxCandles,
     bool highSide, int nasPivotTime, float nasPivotPrice, int spxPivotTime, float spxPivotPrice,
     int activationClose, int capacity) =>
    [nasExtTime, nasExtPrice] = f_extremeAfter(nasCandles, nasPivotTime, highSide)
    [spxExtTime, spxExtPrice] = f_extremeAfter(spxCandles, spxPivotTime, highSide)
    bool nasTaken = not na(nasExtPrice) and (highSide ? nasExtPrice > nasPivotPrice : nasExtPrice < nasPivotPrice)
    bool spxTaken = not na(spxExtPrice) and (highSide ? spxExtPrice > spxPivotPrice : spxExtPrice < spxPivotPrice)
    bool registered = false
    if not na(nasPivotTime) and not na(spxPivotTime) and not na(nasPivotPrice) and not na(spxPivotPrice) and not (nasTaken and spxTaken)
        array.push(refs, SweepReference.new(nasPivotTime, nasPivotPrice, spxPivotTime, spxPivotPrice,
             activationClose, nasTaken, spxTaken, false))
        registered := true
        while array.size(refs) > capacity
            array.shift(refs)
    registered
// Evaluates every active reference of one direction against one closed,
// synchronized 5M candle. Returns at most one validated SMT event. When an event
// is confirmed, every reference that diverged on this candle is consumed so the
// same move cannot create duplicate lines or alerts. References that diverged
// but failed a filter stay active and can confirm on a later candle.
f_evaluateSweeps(array<SweepReference> refs, array<SourceCandle> nasCandles, array<SourceCandle> spxCandles,
     bool highSide, int candleTime, int candleClose,
     float nasExtreme, float spxExtreme, float nasATR, float spxATR, float nasTick, float spxTick,
     int maxReferenceAgeMs, float nasMagnet1, float nasMagnet2) =>
    bool found = false
    float bestRank = na
    int bestRefNASTime = na
    float bestRefNASPrice = na
    int bestRefSPXTime = na
    float bestRefSPXPrice = na
    int bestSweepTime = na
    float bestEndNASPrice = na
    float bestEndSPXPrice = na
    bool bestNASSwept = false
    int divergedCount = 0
    string reason = "no active reference swept"
    int index = 0
    while index < array.size(refs)
        SweepReference activeRef = array.get(refs, index)
        activeRef.divergedNow := false
        bool removeRef = false
        if na(candleTime) or candleTime - math.max(activeRef.nasTime, activeRef.spxTime) > maxReferenceAgeMs
            removeRef := true
        else
            bool candidate = false
            bool nasSweeper = false
            int sweepTime = na
            if activeRef.activationClose == candleClose
                // Activation candle: taken flags were computed at registration and
                // already include this candle.
                if activeRef.nasTaken and activeRef.spxTaken
                    removeRef := true
                else if activeRef.nasTaken or activeRef.spxTaken
                    nasSweeper := activeRef.nasTaken
                    [extTime, extPrice] = f_extremeAfter(nasSweeper ? nasCandles : spxCandles,
                         nasSweeper ? activeRef.nasTime : activeRef.spxTime, highSide)
                    sweepTime := extTime
                    candidate := not na(extTime)
            else
                bool nasNow = not na(nasExtreme) and (highSide ? nasExtreme > activeRef.nasPrice : nasExtreme < activeRef.nasPrice)
                bool spxNow = not na(spxExtreme) and (highSide ? spxExtreme > activeRef.spxPrice : spxExtreme < activeRef.spxPrice)
                activeRef.nasTaken := activeRef.nasTaken or nasNow
                activeRef.spxTaken := activeRef.spxTaken or spxNow
                if activeRef.nasTaken and activeRef.spxTaken
                    // Both markets have taken the level: no divergence is possible.
                    removeRef := true
                else if nasNow or spxNow
                    nasSweeper := nasNow
                    sweepTime := candleTime
                    candidate := true
            if candidate
                activeRef.divergedNow := true
                divergedCount += 1
                float nasEnd = f_candlePrice(nasCandles, sweepTime, highSide)
                float spxEnd = f_candlePrice(spxCandles, sweepTime, highSide)
                bool endpointsKnown = not na(nasEnd) and not na(spxEnd)
                float sweepRef = nasSweeper ? activeRef.nasPrice : activeRef.spxPrice
                float sweepEnd = nasSweeper ? nasEnd : spxEnd
                float heldRef = nasSweeper ? activeRef.spxPrice : activeRef.nasPrice
                float heldEnd = nasSweeper ? spxEnd : nasEnd
                float sweepDistance = highSide ? sweepEnd - sweepRef : sweepRef - sweepEnd
                float heldDistance = highSide ? heldRef - heldEnd : heldEnd - heldRef
                bool segmentClear = endpointsKnown and
                     f_segmentClear(nasCandles, activeRef.nasTime, activeRef.nasPrice, sweepTime, nasEnd, highSide) and
                     f_segmentClear(spxCandles, activeRef.spxTime, activeRef.spxPrice, sweepTime, spxEnd, highSide)
                float sweepATR = nasSweeper ? nasATR : spxATR
                float heldATR = nasSweeper ? spxATR : nasATR
                float sweepTick = nasSweeper ? nasTick : spxTick
                float strengthPct = endpointsKnown and not na(sweepATR) and sweepATR > 0 and not na(heldATR) and heldATR > 0 ?
                     math.min(100.0, 50.0 * (sweepDistance / sweepATR + heldDistance / heldATR)) : na
                bool tickPass = endpointsKnown and not na(sweepTick) and sweepTick > 0 and sweepDistance / sweepTick >= minimumDivergenceTicks and
                     (minSweepATR <= 0 or (not na(sweepATR) and sweepATR > 0 and sweepDistance >= minSweepATR * sweepATR))
                bool percentPass = endpointsKnown
                if endpointsKnown and useMinimumPercentDifference
                    float nasMovePct = highSide ? 100.0 * (nasEnd - activeRef.nasPrice) / activeRef.nasPrice : 100.0 * (activeRef.nasPrice - nasEnd) / activeRef.nasPrice
                    float spxMovePct = highSide ? 100.0 * (spxEnd - activeRef.spxPrice) / activeRef.spxPrice : 100.0 * (activeRef.spxPrice - spxEnd) / activeRef.spxPrice
                    percentPass := math.abs(nasMovePct - spxMovePct) >= minimumPercentDifference
                bool strengthPass = not na(strengthPct) and strengthPct >= minimumStrength
                // Major swing filter: price must have left the level by at least
                // minSwingATR x ATR between the swing and the sweep.
                bool swingPass = true
                if minSwingATR > 0
                    [awayTime, awayPrice] = f_extremeAfter(nasSweeper ? nasCandles : spxCandles,
                         nasSweeper ? activeRef.nasTime : activeRef.spxTime, not highSide)
                    float awayDistance = highSide ? sweepRef - awayPrice : awayPrice - sweepRef
                    swingPass := not na(awayDistance) and not na(sweepATR) and sweepATR > 0 and awayDistance >= minSwingATR * sweepATR
                // Key-level check on NAS100 (the traded market): skip the SMT if an
                // untaken key level sits just beyond it. Levels at the NAS swing
                // itself (e.g. it is the session high) are part of the SMT, not a magnet.
                bool magnetPass = true
                if magnetATR > 0 and endpointsKnown and not na(nasATR) and nasATR > 0
                    float barrier = highSide ? math.max(nasEnd, activeRef.nasPrice) : math.min(nasEnd, activeRef.nasPrice)
                    float eps = 0.1 * nasATR
                    float magnet = na
                    if not na(nasMagnet1) and (highSide ? nasMagnet1 > barrier + eps : nasMagnet1 < barrier - eps)
                        magnet := nasMagnet1
                    else if not na(nasMagnet2) and (highSide ? nasMagnet2 > barrier + eps : nasMagnet2 < barrier - eps)
                        magnet := nasMagnet2
                    if not na(magnet)
                        magnetPass := math.abs(magnet - barrier) >= magnetATR * nasATR
                if segmentClear and tickPass and percentPass and strengthPass and swingPass and magnetPass
                    // Most extreme reference wins: highest high / lowest low.
                    float rank = activeRef.nasPrice
                    if not found or (highSide ? rank > bestRank : rank < bestRank)
                        found := true
                        bestRank := rank
                        bestRefNASTime := activeRef.nasTime
                        bestRefNASPrice := activeRef.nasPrice
                        bestRefSPXTime := activeRef.spxTime
                        bestRefSPXPrice := activeRef.spxPrice
                        bestSweepTime := sweepTime
                        bestEndNASPrice := nasEnd
                        bestEndSPXPrice := spxEnd
                        bestNASSwept := nasSweeper
                else if not found
                    reason := not endpointsKnown ? "source candle history incomplete" :
                         not segmentClear ? "segment crosses an intermediate 5M candle on NAS or SPX" :
                         not tickPass ? "sweep too small (ticks / ATR minimum)" :
                         not percentPass ? "percent filter" : not strengthPass ? "strength below minimum" :
                         not swingPass ? "not a major swing (too small move away)" : "untaken key level just beyond the SMT"
        if removeRef
            array.remove(refs, index)
        else
            index += 1
    if found
        int removeIndex = array.size(refs) - 1
        while removeIndex >= 0
            SweepReference consumed = array.get(refs, removeIndex)
            if consumed.divergedNow
                array.remove(refs, removeIndex)
            removeIndex -= 1
        reason := "confirmed"
    [found, bestRefNASTime, bestRefNASPrice, bestRefSPXTime, bestRefSPXPrice, bestSweepTime,
         bestEndNASPrice, bestEndSPXPrice, bestNASSwept, divergedCount, reason]
f_sendAlert(array<string> keys, bool active, bool allowed, string eventKey,
     int eventSourceClose, int firedAt, string message) =>
    bool sent = false
    if active and allowed and not array.includes(keys, eventKey) and barstate.isrealtime and not na(realtimeStart) and
         not na(eventSourceClose) and not na(firedAt) and eventSourceClose > realtimeStart and
         firedAt > realtimeStart
        alert(message, alert.freq_all)
        array.push(keys, eventKey)
        sent := true
        while array.size(keys) > 256
            array.shift(keys)
    sent
// Parses "HHMM-HHMM" and checks a timestamp in New York time. Handles windows
// that wrap past midnight.
f_inBlockWindow(int ts) =>
    bool inside = false
    if not na(ts) and str.length(blockSession) >= 9
        int startMin = int(str.tonumber(str.substring(blockSession, 0, 2))) * 60 + int(str.tonumber(str.substring(blockSession, 2, 4)))
        int endMin = int(str.tonumber(str.substring(blockSession, 5, 7))) * 60 + int(str.tonumber(str.substring(blockSession, 7, 9)))
        int nowMin = hour(ts, "America/New_York") * 60 + minute(ts, "America/New_York")
        inside := startMin <= endMin ? nowMin >= startMin and nowMin < endMin : nowMin >= startMin or nowMin < endMin
    inside
// JSON body for the smt-bot webhook (app/signals.py reads instrument, indicator,
// signal, price, timeframe and time; trend_aligned=false makes the Telegram
// message info-only; change_24h_pct and bias are shown in Telegram; the rest is kept in `raw`).
f_alertJson(PendingSmt pending, bool trendAligned) =>
    string q = "\""
    string pctText = na(bias24Pct) ? "null" : str.tostring(bias24Pct, "0.00")
    "{" +
         (webhookSecret == "" ? "" : q + "secret" + q + ":" + q + webhookSecret + q + ",") +
         q + "indicator" + q + ":" + q + indicatorId + q + "," +
         q + "broker" + q + ":" + q + "PEPPERSTONE" + q + "," +
         q + "instrument" + q + ":" + q + syminfo.ticker + q + "," +
         q + "pair" + q + ":" + q + nasTicker + "/" + spxTicker + q + "," +
         q + "signal" + q + ":" + q + (pending.bullish ? "BUY" : "SELL") + q + "," +
         q + "price" + q + ":" + str.tostring(pending.confirmationClose, format.mintick) + "," +
         q + "timeframe" + q + ":" + q + "5" + q + "," +
         q + "time" + q + ":" + q + str.format_time(pending.confirmationBarTime, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + q + "," +
         q + "sweeper" + q + ":" + q + pending.sweeper + q + "," +
         q + "bias" + q + ":" + q + pending.trend + q + "," +
         q + "change_24h_pct" + q + ":" + pctText + "," +
         q + "trend_aligned" + q + ":" + (trendAligned ? "true" : "false") + "," +
         q + "smt_level" + q + ":" + (na(pending.smtLevel) ? "null" : str.tostring(pending.smtLevel, format.mintick)) + "," +
         q + "event_id" + q + ":" + q + pending.eventId + q +
         "}"
// Called exactly once per closed, synchronized 5M source candle. The candle that
// confirms the SMT leaves the counter at 0; every later closed 5M candle adds 1.
// Delay 0 = close of the confirming candle, 1 = close of the next 5M candle, etc.
// An event is removed from the queue only when it is due.
f_processPendingAlerts(array<PendingSmt> queue, array<string> sentKeys,
     int sourceCloseTime, int requiredCandles,
     bool alertsEnabled, bool bullishEnabled, bool bearishEnabled) =>
    int index = 0
    while index < array.size(queue)
        PendingSmt pending = array.get(queue, index)
        if sourceCloseTime > pending.confirmationBarTime
            pending.completedCandlesSinceConfirmation := pending.completedCandlesSinceConfirmation + 1
        bool directionEnabled = pending.bullish ? bullishEnabled : bearishEnabled
        if pending.sourceTimeframe == "5" and pending.completedCandlesSinceConfirmation >= requiredCandles
            bool trendAligned = pending.bullish ? pending.trend == "UP" : pending.trend == "DOWN"
            bool inBreakWindow = f_inBlockWindow(pending.confirmationBarTime)
            if not pending.alertSent and alertsEnabled and directionEnabled and (trendAligned or sendCounterTrend) and not inBreakWindow
                string message = f_alertJson(pending, trendAligned)
                bool sent = f_sendAlert(sentKeys, true, alertsEnabled and directionEnabled,
                     pending.eventId, pending.confirmationBarTime, sourceCloseTime, message)
                pending.alertSent := sent
            array.remove(queue, index)
        else
            index += 1
    true
f_recordDraw(array<DrawSmt> historyQueue, array<DrawSmt> realtimeQueue,
     DrawSmt drawing, int limit, bool latestOnly, bool isHistorical) =>
    if isHistorical
        if latestOnly
            array.clear(historyQueue)
        array.push(historyQueue, drawing)
        while array.size(historyQueue) > limit
            array.shift(historyQueue)
    else
        array.push(realtimeQueue, drawing)
        while array.size(realtimeQueue) > limit
            array.shift(realtimeQueue)
    true
f_renderDraw(DrawSmt drawing, array<line> lines, array<string> keys,
     int limit, bool latestOnly, bool showLines, color bullColor, color bearColor,
     int transparency, int width) =>
    string key = (drawing.bullish ? "B:" : "S:") + str.tostring(drawing.eventId)
    if showLines and not array.includes(keys, key) and drawing.x2 > drawing.x1
        if latestOnly
            while array.size(lines) > 0
                line.delete(array.shift(lines))
        color baseColor = drawing.muted ? greyColor : drawing.bullish ? bullColor : bearColor
        line id = line.new(x1=drawing.x1, y1=drawing.y1, x2=drawing.x2, y2=drawing.y2,
             xloc=xloc.bar_time, extend=extend.none, color=color.new(baseColor, transparency), width=width)
        array.push(lines, id)
        array.push(keys, key)
        while array.size(lines) > limit
            line.delete(array.shift(lines))
        while array.size(keys) > limit
            array.shift(keys)
    true
//====================================================
// Persistent 5M-only state
//====================================================
varip int lastSourceClose = na
// Open time of the first 5M candle after the latest feed gap (daily break / weekend).
varip int lastBreakTime = na
varip int breakResetCount = 0
varip int lastNASHighPivotTime = na
varip int lastSPXHighPivotTime = na
varip int lastNASLowPivotTime = na
varip int lastSPXLowPivotTime = na
varip array<PivotPoint> nasHighQueue = array.new<PivotPoint>()
varip array<PivotPoint> spxHighQueue = array.new<PivotPoint>()
varip array<PivotPoint> nasLowQueue = array.new<PivotPoint>()
varip array<PivotPoint> spxLowQueue = array.new<PivotPoint>()
// Alert pivots have independent queues and swing references. Changing their
// strength cannot alter the drawing engine's matched pivots or line geometry.
varip int lastAlertNASHighPivotTime = na
varip int lastAlertSPXHighPivotTime = na
varip int lastAlertNASLowPivotTime = na
varip int lastAlertSPXLowPivotTime = na
varip array<PivotPoint> alertNASHighQueue = array.new<PivotPoint>()
varip array<PivotPoint> alertSPXHighQueue = array.new<PivotPoint>()
varip array<PivotPoint> alertNASLowQueue = array.new<PivotPoint>()
varip array<PivotPoint> alertSPXLowQueue = array.new<PivotPoint>()
varip int alertReferenceNASHighTime = na
varip float alertReferenceNASHigh = na
varip int alertReferenceSPXHighTime = na
varip float alertReferenceSPXHigh = na
varip int alertReferenceNASLowTime = na
varip float alertReferenceNASLow = na
varip int alertReferenceSPXLowTime = na
varip float alertReferenceSPXLow = na
varip array<string> alertProcessedKeys = array.new_string()
varip array<SourceCandle> nasSourceCandles = array.new<SourceCandle>()
varip array<SourceCandle> spxSourceCandles = array.new<SourceCandle>()
// Keep alert-segment history independent so Alert Pivot cannot change the
// drawing engine's candle arrays or retention window.
varip array<SourceCandle> alertNASSourceCandles = array.new<SourceCandle>()
varip array<SourceCandle> alertSPXSourceCandles = array.new<SourceCandle>()
// A source bar can confirm one high and one low event. Keep enough entries for
// both directions across the maximum configured 20 source-candle delay.
varip array<PendingSmt> pendingAlerts = array.new<PendingSmt>()
varip array<DrawSmt> pendingDraws = array.new<DrawSmt>()
var array<DrawSmt> historicalDraws = array.new<DrawSmt>()
// Active sweep references: matched, confirmed pivot pairs that have not been
// taken by both markets and have not yet produced an SMT event.
varip array<SweepReference> activeHighReferences = array.new<SweepReference>()
varip array<SweepReference> activeLowReferences = array.new<SweepReference>()
varip array<string> alertedKeys = array.new_string()
varip array<string> processedEventKeys = array.new_string()
var array<string> drawnKeys = array.new_string()
var array<line> smtLines = array.new<line>()
varip int nasPivotCount = 0
varip int spxPivotCount = 0
varip int matchedHighCount = 0
varip int matchedLowCount = 0
varip int bullishSignalCount = 0
varip int bearishSignalCount = 0
varip int lastDebugSourceClose = na
varip string debugHighPair = "waiting for confirmed pivots"
varip string debugHighSync = "not evaluated"
varip string debugLowPair = "waiting for confirmed pivots"
varip string debugLowSync = "not evaluated"
varip string debugSignalStatus = "no confirmed pair evaluated"
varip string debugAlertStatus = "no alert event"
varip string debugAlertReason = "no alert triggered"
//====================================================
// Two 5M source requests per execution. The selected request budget bounds the
// historical window; all stateful work is gated to a new closed source bar.
//====================================================
if canRunEngine
    array<SourceBundle> nasBars = array.new<SourceBundle>()
    array<SourceBundle> spxBars = array.new<SourceBundle>()
    if chartSeconds <= SOURCE_SECONDS
        SourceBundle nasSingle = na
        SourceBundle spxSingle = na
        if maximumHistoricalSignals == 10
            nasSingle := f_request900(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
            spxSingle := f_request900(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        else if maximumHistoricalSignals == 20
            nasSingle := f_request1800(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
            spxSingle := f_request1800(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        else if maximumHistoricalSignals == 30
            nasSingle := f_request2600(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
            spxSingle := f_request2600(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        else if maximumHistoricalSignals == 50
            nasSingle := f_request4200(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
            spxSingle := f_request4200(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        else
            nasSingle := f_request8000(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
            spxSingle := f_request8000(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        // Previous closed candle first, then the current one. Both pass through the
        // same newSourceBar gate, so a candle is never processed twice.
        if not na(nasSingle) and not na(spxSingle)
            SourceBundle nasPrevious = f_previousBundle(nasSingle)
            SourceBundle spxPrevious = f_previousBundle(spxSingle)
            if not na(nasPrevious) and not na(spxPrevious)
                array.push(nasBars, nasPrevious)
                array.push(spxBars, spxPrevious)
        if not na(nasSingle)
            array.push(nasBars, nasSingle)
        if not na(spxSingle)
            array.push(spxBars, spxSingle)
    else if maximumHistoricalSignals == 10
        nasBars := f_requestLower900(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        spxBars := f_requestLower900(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
    else if maximumHistoricalSignals == 20
        nasBars := f_requestLower1800(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        spxBars := f_requestLower1800(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
    else if maximumHistoricalSignals == 30
        nasBars := f_requestLower2600(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        spxBars := f_requestLower2600(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
    else if maximumHistoricalSignals == 50
        nasBars := f_requestLower4200(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        spxBars := f_requestLower4200(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
    else
        nasBars := f_requestLower8000(nasSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
        spxBars := f_requestLower8000(spxSymbol, drawingPivotStrength, alertPivotStrength, needBearishEngine, needBullishEngine)
    int nasIndex = 0
    int spxIndex = 0
    while nasIndex < array.size(nasBars) and spxIndex < array.size(spxBars)
        SourceBundle nasSource = array.get(nasBars, nasIndex)
        SourceBundle spxSource = array.get(spxBars, spxIndex)
        if na(nasSource) or na(spxSource)
            nasIndex += 1
            spxIndex += 1
        else if nasSource.sourceTime == spxSource.sourceTime and nasSource.sourceClose == spxSource.sourceClose
            float nasHigh = nasSource.highValue
            float nasLow = nasSource.lowValue
            float nasClosePrice = nasSource.closeValue
            int nasTime = nasSource.sourceTime
            int nasClose = nasSource.sourceClose
            float nasTick = nasSource.tickSize
            float nasHighPivot = nasSource.pivotHigh
            int nasHighPivotTime = nasSource.pivotHighTime
            float nasLowPivot = nasSource.pivotLow
            int nasLowPivotTime = nasSource.pivotLowTime
            float nasATR = nasSource.atrValue
            string nasTrendState = nasSource.trendDir == 1 ? "UP" : nasSource.trendDir == -1 ? "DOWN" : "NONE"
            float spxHigh = spxSource.highValue
            float spxLow = spxSource.lowValue
            float spxClosePrice = spxSource.closeValue
            float chartConfirmationClose = drawUsingNASPrices ? nasClosePrice : spxClosePrice
            int spxTime = spxSource.sourceTime
            int spxClose = spxSource.sourceClose
            float spxTick = spxSource.tickSize
            float spxHighPivot = spxSource.pivotHigh
            int spxHighPivotTime = spxSource.pivotHighTime
            float spxLowPivot = spxSource.pivotLow
            int spxLowPivotTime = spxSource.pivotLowTime
            float spxATR = spxSource.atrValue
            bool nasClosed = not na(nasTime) and not na(nasClose) and nasClose <= timenow
            bool spxClosed = not na(spxTime) and not na(spxClose) and spxClose <= timenow
            bool sourceAligned = not na(nasTime) and not na(spxTime) and not na(nasClose) and not na(spxClose) and nasTime == spxTime and nasClose == spxClose
            bool sourceSynchronized = sourceAligned and nasClosed and spxClosed
            bool newSourceBar = sourceSynchronized and (na(lastSourceClose) or nasClose > lastSourceClose)
            if newSourceBar
                // CFD daily break / weekend: a gap in the 5M feed. Drop every open
                // reference and unmatched pivot so pre-break swings are never
                // compared with post-break price.
                if resetAcrossBreak and not na(lastSourceClose) and nasTime - lastSourceClose >= gapResetMinutes * 60000
                    lastBreakTime := nasTime
                    breakResetCount += 1
                    array.clear(activeHighReferences)
                    array.clear(activeLowReferences)
                    array.clear(nasHighQueue)
                    array.clear(spxHighQueue)
                    array.clear(nasLowQueue)
                    array.clear(spxLowQueue)
                    array.clear(nasSourceCandles)
                    array.clear(spxSourceCandles)
                lastSourceClose := nasClose
                lastDebugSourceClose := nasClose
                int sourceCandleCapacity = maxSwingDistanceBars + 2 * swingToleranceBars + drawingPivotStrength + 3
                f_pushSourceCandle(nasSourceCandles,
                     SourceCandle.new(nasTime, nasClose, nasHigh, nasLow), sourceCandleCapacity)
                f_pushSourceCandle(spxSourceCandles,
                     SourceCandle.new(spxTime, spxClose, spxHigh, spxLow), sourceCandleCapacity)
                int alertSourceCandleCapacity = maxSwingDistanceBars + 2 * swingToleranceBars + alertPivotStrength + 3
                f_pushSourceCandle(alertNASSourceCandles,
                     SourceCandle.new(nasTime, nasClose, nasHigh, nasLow), alertSourceCandleCapacity)
                f_pushSourceCandle(alertSPXSourceCandles,
                     SourceCandle.new(spxTime, spxClose, spxHigh, spxLow), alertSourceCandleCapacity)
                if debugMode and drawingsVisible
                    SourceBundle dbgChart = drawUsingNASPrices ? nasSource : spxSource
                    SourceBundle dbgOther = drawUsingNASPrices ? spxSource : nasSource
                    string otherName = drawUsingNASPrices ? spxTicker : nasTicker
                    if dbgChart.highRejectCode > 0
                        label.new(dbgChart.highRejectTime, dbgChart.highRejectPrice, "H x " + (dbgChart.highRejectCode == 1 ? "not swing extreme" : dbgChart.highRejectCode == 3 ? "pullback too small" : "mid-range") + " | trend " + (dbgChart.trendDir == 1 ? "UP" : dbgChart.trendDir == -1 ? "DOWN" : "NONE"),
                             xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny, color=color.new(color.gray, 20), textcolor=color.white)
                    if dbgChart.lowRejectCode > 0
                        label.new(dbgChart.lowRejectTime, dbgChart.lowRejectPrice, "L x " + (dbgChart.lowRejectCode == 1 ? "not swing extreme" : dbgChart.lowRejectCode == 3 ? "pullback too small" : "mid-range") + " | trend " + (dbgChart.trendDir == 1 ? "UP" : dbgChart.trendDir == -1 ? "DOWN" : "NONE"),
                             xloc=xloc.bar_time, style=label.style_label_up, size=size.tiny, color=color.new(color.gray, 20), textcolor=color.white)
                    // The other market's swing is filtered too: show it on this chart's candle.
                    if dbgOther.highRejectCode > 0
                        label.new(dbgOther.highRejectTime, drawUsingNASPrices ? nasHigh : spxHigh, otherName + " H x " + (dbgOther.highRejectCode == 1 ? "not swing extreme" : dbgOther.highRejectCode == 3 ? "pullback too small" : "mid-range") + " | trend " + (dbgOther.trendDir == 1 ? "UP" : dbgOther.trendDir == -1 ? "DOWN" : "NONE"),
                             xloc=xloc.bar_time, yloc=yloc.abovebar, style=label.style_label_down, size=size.tiny, color=color.new(color.purple, 30), textcolor=color.white)
                    if dbgOther.lowRejectCode > 0
                        label.new(dbgOther.lowRejectTime, drawUsingNASPrices ? nasLow : spxLow, otherName + " L x " + (dbgOther.lowRejectCode == 1 ? "not swing extreme" : dbgOther.lowRejectCode == 3 ? "pullback too small" : "mid-range") + " | trend " + (dbgOther.trendDir == 1 ? "UP" : dbgOther.trendDir == -1 ? "DOWN" : "NONE"),
                             xloc=xloc.bar_time, yloc=yloc.belowbar, style=label.style_label_up, size=size.tiny, color=color.new(color.purple, 30), textcolor=color.white)
                // Independent alert-pivot engine. Pivot alerts are evaluated on
                // this aligned, closed 5M NAS/SPX source pair only.
                float nasAlertHighPivot = nasSource.alertPivotHigh
                int nasAlertHighPivotTime = nasSource.alertPivotHighTime
                float nasAlertLowPivot = nasSource.alertPivotLow
                int nasAlertLowPivotTime = nasSource.alertPivotLowTime
                float spxAlertHighPivot = spxSource.alertPivotHigh
                int spxAlertHighPivotTime = spxSource.alertPivotHighTime
                float spxAlertLowPivot = spxSource.alertPivotLow
                int spxAlertLowPivotTime = spxSource.alertPivotLowTime
                bool newAlertNASHigh = enableAlerts and enableBearishAlerts and not na(nasAlertHighPivotTime) and (na(lastAlertNASHighPivotTime) or nasAlertHighPivotTime != lastAlertNASHighPivotTime)
                bool newAlertSPXHigh = enableAlerts and enableBearishAlerts and not na(spxAlertHighPivotTime) and (na(lastAlertSPXHighPivotTime) or spxAlertHighPivotTime != lastAlertSPXHighPivotTime)
                bool newAlertNASLow = enableAlerts and enableBullishAlerts and not na(nasAlertLowPivotTime) and (na(lastAlertNASLowPivotTime) or nasAlertLowPivotTime != lastAlertNASLowPivotTime)
                bool newAlertSPXLow = enableAlerts and enableBullishAlerts and not na(spxAlertLowPivotTime) and (na(lastAlertSPXLowPivotTime) or spxAlertLowPivotTime != lastAlertSPXLowPivotTime)
                if newAlertNASHigh
                    lastAlertNASHighPivotTime := nasAlertHighPivotTime
                    f_pushPivot(alertNASHighQueue, nasAlertHighPivot, nasAlertHighPivotTime, alertPivotQueueCapacity)
                if newAlertSPXHigh
                    lastAlertSPXHighPivotTime := spxAlertHighPivotTime
                    f_pushPivot(alertSPXHighQueue, spxAlertHighPivot, spxAlertHighPivotTime, alertPivotQueueCapacity)
                if newAlertNASLow
                    lastAlertNASLowPivotTime := nasAlertLowPivotTime
                    f_pushPivot(alertNASLowQueue, nasAlertLowPivot, nasAlertLowPivotTime, alertPivotQueueCapacity)
                if newAlertSPXLow
                    lastAlertSPXLowPivotTime := spxAlertLowPivotTime
                    f_pushPivot(alertSPXLowQueue, spxAlertLowPivot, spxAlertLowPivotTime, alertPivotQueueCapacity)
                int alertQueueAgeMs = (swingToleranceBars + alertPivotStrength + 1) * SOURCE_MS
                // Independent alert-pivot validation caused alerts to diverge from drawn SMTs.
                // Keep its legacy calculations inert; validated drawing events are queued below.
                if enableAlerts and enableBearishAlerts and false
                    [alertHighMatched, alertHighNASTime, alertHighNASPrice, alertHighSPXTime, alertHighSPXPrice, alertHighComparedNASTime, alertHighComparedSPXTime] = f_takeMatchedPivot(alertNASHighQueue, alertSPXHighQueue, swingToleranceBars * SOURCE_MS, nasTime, alertQueueAgeMs)
                    if alertHighMatched
                        bool hasAlertHighReference = not na(alertReferenceNASHighTime) and not na(alertReferenceSPXHighTime) and not na(alertReferenceNASHigh) and not na(alertReferenceSPXHigh)
                        bool alertHighChronological = hasAlertHighReference and alertHighNASTime > alertReferenceNASHighTime and alertHighSPXTime > alertReferenceSPXHighTime
                        int alertHighPairTime = math.max(alertHighNASTime, alertHighSPXTime)
                        int alertHighPriorPairTime = hasAlertHighReference ? math.max(alertReferenceNASHighTime, alertReferenceSPXHighTime) : na
                        bool alertHighWithinDistance = alertHighChronological and alertHighPairTime - alertHighPriorPairTime <= maxSwingDistanceBars * SOURCE_MS
                        bool alertNASHH = hasAlertHighReference and alertHighNASPrice > alertReferenceNASHigh
                        bool alertSPXHH = hasAlertHighReference and alertHighSPXPrice > alertReferenceSPXHigh
                        bool alertBearishDivergence = alertNASHH != alertSPXHH
                        bool alertHighClear = false
                        if hasAlertHighReference and alertHighWithinDistance and alertBearishDivergence
                            alertHighClear := f_segmentClear(alertNASSourceCandles, alertReferenceNASHighTime, alertReferenceNASHigh, alertHighNASTime, alertHighNASPrice, true) and f_segmentClear(alertSPXSourceCandles, alertReferenceSPXHighTime, alertReferenceSPXHigh, alertHighSPXTime, alertHighSPXPrice, true)
                        if hasAlertHighReference and alertHighWithinDistance and alertBearishDivergence and alertHighClear
                            bool alertNASSweptHigh = alertNASHH
                            float alertSweepDistance = alertNASSweptHigh ? alertHighNASPrice - alertReferenceNASHigh : alertHighSPXPrice - alertReferenceSPXHigh
                            float alertHeldDistance = alertNASSweptHigh ? alertReferenceSPXHigh - alertHighSPXPrice : alertReferenceNASHigh - alertHighNASPrice
                            float alertSweepATR = alertNASSweptHigh ? nasATR : spxATR
                            float alertHeldATR = alertNASSweptHigh ? spxATR : nasATR
                            float alertSweepTick = alertNASSweptHigh ? nasTick : spxTick
                            float alertStrengthPct = not na(alertSweepATR) and alertSweepATR > 0 and not na(alertHeldATR) and alertHeldATR > 0 ? math.min(100.0, 50.0 * (alertSweepDistance / alertSweepATR + alertHeldDistance / alertHeldATR)) : na
                            bool alertTickPass = not na(alertSweepTick) and alertSweepTick > 0 and alertSweepDistance / alertSweepTick >= minimumDivergenceTicks
                            bool alertPercentPass = not useMinimumPercentDifference or math.abs(100.0 * (alertHighNASPrice - alertReferenceNASHigh) / alertReferenceNASHigh - 100.0 * (alertHighSPXPrice - alertReferenceSPXHigh) / alertReferenceSPXHigh) >= minimumPercentDifference
                            bool alertStrengthPass = not na(alertStrengthPct) and alertStrengthPct >= minimumStrength
                            string alertEventKey = "AS:" + str.tostring(alertPivotStrength) + ":" + str.tostring(alertReferenceNASHighTime) + ":" + str.tostring(alertReferenceSPXHighTime) + ">" + str.tostring(alertHighNASTime) + ":" + str.tostring(alertHighSPXTime) + ":C:" + str.tostring(nasClose)
                            if alertTickPass and alertPercentPass and alertStrengthPass and not array.includes(alertProcessedKeys, alertEventKey) and array.size(pendingAlerts) < pendingAlertCapacity
                                array.push(alertProcessedKeys, alertEventKey)
                                while array.size(alertProcessedKeys) > 512
                                    array.shift(alertProcessedKeys)
                                array.push(pendingAlerts, PendingSmt.new(alertEventKey, false, "5", nasClose, chartConfirmationClose, 0, false))
                            if not hasAlertHighReference or alertHighChronological
                                alertReferenceNASHighTime := alertHighNASTime
                                alertReferenceNASHigh := alertHighNASPrice
                                alertReferenceSPXHighTime := alertHighSPXTime
                                alertReferenceSPXHigh := alertHighSPXPrice
                if enableAlerts and enableBullishAlerts and false
                    [alertLowMatched, alertLowNASTime, alertLowNASPrice, alertLowSPXTime, alertLowSPXPrice, alertLowComparedNASTime, alertLowComparedSPXTime] = f_takeMatchedPivot(alertNASLowQueue, alertSPXLowQueue, swingToleranceBars * SOURCE_MS, nasTime, alertQueueAgeMs)
                    if alertLowMatched
                        bool hasAlertLowReference = not na(alertReferenceNASLowTime) and not na(alertReferenceSPXLowTime) and not na(alertReferenceNASLow) and not na(alertReferenceSPXLow)
                        bool alertLowChronological = hasAlertLowReference and alertLowNASTime > alertReferenceNASLowTime and alertLowSPXTime > alertReferenceSPXLowTime
                        int alertLowPairTime = math.max(alertLowNASTime, alertLowSPXTime)
                        int alertLowPriorPairTime = hasAlertLowReference ? math.max(alertReferenceNASLowTime, alertReferenceSPXLowTime) : na
                        bool alertLowWithinDistance = alertLowChronological and alertLowPairTime - alertLowPriorPairTime <= maxSwingDistanceBars * SOURCE_MS
                        bool alertNASLL = hasAlertLowReference and alertLowNASPrice < alertReferenceNASLow
                        bool alertSPXLL = hasAlertLowReference and alertLowSPXPrice < alertReferenceSPXLow
                        bool alertBullishDivergence = alertNASLL != alertSPXLL
                        bool alertLowClear = false
                        if hasAlertLowReference and alertLowWithinDistance and alertBullishDivergence
                            alertLowClear := f_segmentClear(alertNASSourceCandles, alertReferenceNASLowTime, alertReferenceNASLow, alertLowNASTime, alertLowNASPrice, false) and f_segmentClear(alertSPXSourceCandles, alertReferenceSPXLowTime, alertReferenceSPXLow, alertLowSPXTime, alertLowSPXPrice, false)
                        if hasAlertLowReference and alertLowWithinDistance and alertBullishDivergence and alertLowClear
                            bool alertNASSweptLow = alertNASLL
                            float alertSweepDistance = alertNASSweptLow ? alertReferenceNASLow - alertLowNASPrice : alertReferenceSPXLow - alertLowSPXPrice
                            float alertHeldDistance = alertNASSweptLow ? alertLowSPXPrice - alertReferenceSPXLow : alertLowNASPrice - alertReferenceNASLow
                            float alertSweepATR = alertNASSweptLow ? nasATR : spxATR
                            float alertHeldATR = alertNASSweptLow ? spxATR : nasATR
                            float alertSweepTick = alertNASSweptLow ? nasTick : spxTick
                            float alertStrengthPct = not na(alertSweepATR) and alertSweepATR > 0 and not na(alertHeldATR) and alertHeldATR > 0 ? math.min(100.0, 50.0 * (alertSweepDistance / alertSweepATR + alertHeldDistance / alertHeldATR)) : na
                            bool alertTickPass = not na(alertSweepTick) and alertSweepTick > 0 and alertSweepDistance / alertSweepTick >= minimumDivergenceTicks
                            bool alertPercentPass = not useMinimumPercentDifference or math.abs(100.0 * (alertReferenceNASLow - alertLowNASPrice) / alertReferenceNASLow - 100.0 * (alertReferenceSPXLow - alertLowSPXPrice) / alertReferenceSPXLow) >= minimumPercentDifference
                            bool alertStrengthPass = not na(alertStrengthPct) and alertStrengthPct >= minimumStrength
                            string alertEventKey = "AB:" + str.tostring(alertPivotStrength) + ":" + str.tostring(alertReferenceNASLowTime) + ":" + str.tostring(alertReferenceSPXLowTime) + ">" + str.tostring(alertLowNASTime) + ":" + str.tostring(alertLowSPXTime) + ":C:" + str.tostring(nasClose)
                            if alertTickPass and alertPercentPass and alertStrengthPass and not array.includes(alertProcessedKeys, alertEventKey) and array.size(pendingAlerts) < pendingAlertCapacity
                                array.push(alertProcessedKeys, alertEventKey)
                                while array.size(alertProcessedKeys) > 512
                                    array.shift(alertProcessedKeys)
                                array.push(pendingAlerts, PendingSmt.new(alertEventKey, true, "5", nasClose, chartConfirmationClose, 0, false))
                            if not hasAlertLowReference or alertLowChronological
                                alertReferenceNASLowTime := alertLowNASTime
                                alertReferenceNASLow := alertLowNASPrice
                                alertReferenceSPXLowTime := alertLowSPXTime
                                alertReferenceSPXLow := alertLowSPXPrice
                bool newNASHighPivot = needBearishEngine and not na(nasHighPivotTime) and (na(lastNASHighPivotTime) or nasHighPivotTime != lastNASHighPivotTime) and (na(lastBreakTime) or nasHighPivotTime >= lastBreakTime)
                bool newSPXHighPivot = needBearishEngine and not na(spxHighPivotTime) and (na(lastSPXHighPivotTime) or spxHighPivotTime != lastSPXHighPivotTime) and (na(lastBreakTime) or spxHighPivotTime >= lastBreakTime)
                bool newNASLowPivot = needBullishEngine and not na(nasLowPivotTime) and (na(lastNASLowPivotTime) or nasLowPivotTime != lastNASLowPivotTime) and (na(lastBreakTime) or nasLowPivotTime >= lastBreakTime)
                bool newSPXLowPivot = needBullishEngine and not na(spxLowPivotTime) and (na(lastSPXLowPivotTime) or spxLowPivotTime != lastSPXLowPivotTime) and (na(lastBreakTime) or spxLowPivotTime >= lastBreakTime)
                if newNASHighPivot
                    lastNASHighPivotTime := nasHighPivotTime
                    nasPivotCount += 1
                    f_pushPivot(nasHighQueue, nasHighPivot, nasHighPivotTime, pivotQueueCapacity)
                if newSPXHighPivot
                    lastSPXHighPivotTime := spxHighPivotTime
                    spxPivotCount += 1
                    f_pushPivot(spxHighQueue, spxHighPivot, spxHighPivotTime, pivotQueueCapacity)
                if newNASLowPivot
                    lastNASLowPivotTime := nasLowPivotTime
                    nasPivotCount += 1
                    f_pushPivot(nasLowQueue, nasLowPivot, nasLowPivotTime, pivotQueueCapacity)
                if newSPXLowPivot
                    lastSPXLowPivotTime := spxLowPivotTime
                    spxPivotCount += 1
                    f_pushPivot(spxLowQueue, spxLowPivot, spxLowPivotTime, pivotQueueCapacity)
                if newNASHighPivot or newSPXHighPivot
                    debugHighPair := "NAS " + f_debugTime(lastNASHighPivotTime) + " / SPX " + f_debugTime(lastSPXHighPivotTime)
                    debugHighSync := "waiting for confirmed one-to-one match"
                if newNASLowPivot or newSPXLowPivot
                    debugLowPair := "NAS " + f_debugTime(lastNASLowPivotTime) + " / SPX " + f_debugTime(lastSPXLowPivotTime)
                    debugLowSync := "waiting for confirmed one-to-one match"
                // Match confirmed pivot highs one-to-one, then compare this matched
                // swing pair with the prior matched swing pair. Candle wicks alone can
                // never create SMT events.
                int toleranceMs = swingToleranceBars * SOURCE_MS
                int queueAgeMs = (swingToleranceBars + drawingPivotStrength + 1) * SOURCE_MS
                // Sweep-based SMT. Matched confirmed pivot pairs become active
                // reference levels. A closed, synchronized 5M candle on which exactly one
                // market takes its reference (and the other market has never taken its
                // own) is the SMT event. The drawing and the alert below are both built
                // from this single validated event.
                int maxReferenceAgeMs = maxSwingDistanceBars * SOURCE_MS
                if needBearishEngine
                    [highMatched, highNASTime, highNASPrice, highSPXTime, highSPXPrice, highComparedNASTime, highComparedSPXTime] =
                         f_takeMatchedPivot(nasHighQueue, spxHighQueue, toleranceMs, nasTime, queueAgeMs)
                    if not na(highComparedNASTime) and not na(highComparedSPXTime)
                        debugHighPair := "NAS " + f_debugTime(highComparedNASTime) + " / SPX " + f_debugTime(highComparedSPXTime)
                        debugHighSync := highMatched ? "PASS (within " + str.tostring(swingToleranceBars) + " bars)" : "FAIL (outside tolerance / waiting)"
                    if highMatched
                        matchedHighCount += 1
                        debugHighPair := "NAS " + f_debugTime(highNASTime) + " @ " + str.tostring(highNASPrice, format.mintick) +
                             " | SPX " + f_debugTime(highSPXTime) + " @ " + str.tostring(highSPXPrice, format.mintick)
                        bool highRegistered = f_registerReference(activeHighReferences, nasSourceCandles, spxSourceCandles, true,
                             highNASTime, highNASPrice, highSPXTime, highSPXPrice, nasClose, REFERENCE_CAPACITY)
                        if debugMode and drawingsVisible and highRegistered
                            label.new(drawUsingNASPrices ? highNASTime : highSPXTime, drawUsingNASPrices ? highNASPrice : highSPXPrice, "ref",
                                 xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny, color=color.new(color.orange, 20), textcolor=color.white)
                        debugSignalStatus := highRegistered ? "High pair registered as active sweep reference" :
                             "High pair already taken by both markets; not registered"
                    else if not na(highComparedNASTime) and not na(highComparedSPXTime)
                        debugSignalStatus := "High pivots not matched; no reference registered"
                    [bearFound, bearRefNASTime, bearRefNASPrice, bearRefSPXTime, bearRefSPXPrice, bearSweepTime,
                         bearEndNASPrice, bearEndSPXPrice, bearNASSwept, bearDivergedCount, bearReason] =
                         f_evaluateSweeps(activeHighReferences, nasSourceCandles, spxSourceCandles, true, nasTime, nasClose,
                         nasHigh, spxHigh, nasATR, spxATR, nasTick, spxTick, maxReferenceAgeMs,
                         nasSource.magnetAbove1, nasSource.magnetAbove2)
                    if bearFound
                        string eventKey = "S:" + str.tostring(bearRefNASTime) + ":" + str.tostring(bearRefSPXTime) + ">" + str.tostring(bearSweepTime) + ":" + str.tostring(bearSweepTime) + ":C:" + str.tostring(nasClose)
                        if not array.includes(processedEventKeys, eventKey)
                            array.push(processedEventKeys, eventKey)
                            while array.size(processedEventKeys) > 512
                                array.shift(processedEventKeys)
                            bearishSignalCount += 1
                            debugSignalStatus := "BEARISH SMT confirmed: " + (bearNASSwept ? "NAS swept high; SPX held" : "SPX swept high; NAS held")
                            // Trend filter: the drawing and the alert follow the same decision.
                            bool bearCounter = trendMode != "Off" and nasTrendState == "UP"
                            bool bearMuted = trendMode != "Off" and nasTrendState != "DOWN"
                            bool bearHidden = trendMode == "Hide counter-trend" and bearCounter
                            if bearHidden
                                debugSignalStatus := debugSignalStatus + " (hidden: counter-trend)"
                                if debugMode and drawingsVisible
                                    label.new(nasTime, drawUsingNASPrices ? nasHigh : spxHigh, "bear SMT hidden: trend " + nasTrendState,
                                         xloc=xloc.bar_time, style=label.style_label_down, size=size.small, color=color.new(color.gray, 20), textcolor=color.white)
                            // The drawing and the alert share this one validated event.
                            if not bearHidden and enableAlerts and enableBearishAlerts and not array.includes(alertProcessedKeys, eventKey)
                                array.push(alertProcessedKeys, eventKey)
                                while array.size(alertProcessedKeys) > 512
                                    array.shift(alertProcessedKeys)
                                array.push(pendingAlerts, PendingSmt.new(eventKey, false, "5", nasClose, chartConfirmationClose, 0, false, bearNASSwept ? nasTicker : spxTicker, drawUsingNASPrices ? math.max(bearRefNASPrice, bearEndNASPrice) : math.max(bearRefSPXPrice, bearEndSPXPrice), nasTrendState))
                            int lineStartTime = drawUsingNASPrices ? bearRefNASTime : bearRefSPXTime
                            float lineStartPrice = drawUsingNASPrices ? bearRefNASPrice : bearRefSPXPrice
                            float lineEndPrice = drawUsingNASPrices ? bearEndNASPrice : bearEndSPXPrice
                            if not bearHidden and showHistoricalLines and drawingsVisible and showBearishLines
                                DrawSmt drawing = DrawSmt.new(false, bearMuted, nasClose, lineStartTime, lineStartPrice, bearSweepTime, lineEndPrice)
                                f_recordDraw(historicalDraws, pendingDraws, drawing, maximumHistoricalSignals, showOnlyLatest, barstate.ishistory)
                    else if bearDivergedCount > 0
                        debugSignalStatus := "Bearish sweep not confirmed: " + bearReason
                        if debugMode and drawingsVisible
                            label.new(nasTime, drawUsingNASPrices ? nasHigh : spxHigh, "bear SMT x " + bearReason,
                                 xloc=xloc.bar_time, style=label.style_label_down, size=size.small, color=color.new(color.red, 40), textcolor=color.white)
                // Bullish SMT uses the same reference/sweep logic on confirmed lows.
                if needBullishEngine
                    [lowMatched, lowNASTime, lowNASPrice, lowSPXTime, lowSPXPrice, lowComparedNASTime, lowComparedSPXTime] =
                         f_takeMatchedPivot(nasLowQueue, spxLowQueue, toleranceMs, nasTime, queueAgeMs)
                    if not na(lowComparedNASTime) and not na(lowComparedSPXTime)
                        debugLowPair := "NAS " + f_debugTime(lowComparedNASTime) + " / SPX " + f_debugTime(lowComparedSPXTime)
                        debugLowSync := lowMatched ? "PASS (within " + str.tostring(swingToleranceBars) + " bars)" : "FAIL (outside tolerance / waiting)"
                    if lowMatched
                        matchedLowCount += 1
                        debugLowPair := "NAS " + f_debugTime(lowNASTime) + " @ " + str.tostring(lowNASPrice, format.mintick) +
                             " | SPX " + f_debugTime(lowSPXTime) + " @ " + str.tostring(lowSPXPrice, format.mintick)
                        bool lowRegistered = f_registerReference(activeLowReferences, nasSourceCandles, spxSourceCandles, false,
                             lowNASTime, lowNASPrice, lowSPXTime, lowSPXPrice, nasClose, REFERENCE_CAPACITY)
                        if debugMode and drawingsVisible and lowRegistered
                            label.new(drawUsingNASPrices ? lowNASTime : lowSPXTime, drawUsingNASPrices ? lowNASPrice : lowSPXPrice, "ref",
                                 xloc=xloc.bar_time, style=label.style_label_up, size=size.tiny, color=color.new(color.orange, 20), textcolor=color.white)
                        debugSignalStatus := lowRegistered ? "Low pair registered as active sweep reference" :
                             "Low pair already taken by both markets; not registered"
                    else if not na(lowComparedNASTime) and not na(lowComparedSPXTime)
                        debugSignalStatus := "Low pivots not matched; no reference registered"
                    [bullFound, bullRefNASTime, bullRefNASPrice, bullRefSPXTime, bullRefSPXPrice, bullSweepTime,
                         bullEndNASPrice, bullEndSPXPrice, bullNASSwept, bullDivergedCount, bullReason] =
                         f_evaluateSweeps(activeLowReferences, nasSourceCandles, spxSourceCandles, false, nasTime, nasClose,
                         nasLow, spxLow, nasATR, spxATR, nasTick, spxTick, maxReferenceAgeMs,
                         nasSource.magnetBelow1, nasSource.magnetBelow2)
                    if bullFound
                        string eventKey = "B:" + str.tostring(bullRefNASTime) + ":" + str.tostring(bullRefSPXTime) + ">" + str.tostring(bullSweepTime) + ":" + str.tostring(bullSweepTime) + ":C:" + str.tostring(nasClose)
                        if not array.includes(processedEventKeys, eventKey)
                            array.push(processedEventKeys, eventKey)
                            while array.size(processedEventKeys) > 512
                                array.shift(processedEventKeys)
                            bullishSignalCount += 1
                            debugSignalStatus := "BULLISH SMT confirmed: " + (bullNASSwept ? "NAS swept low; SPX held" : "SPX swept low; NAS held")
                            // Trend filter: the drawing and the alert follow the same decision.
                            bool bullCounter = trendMode != "Off" and nasTrendState == "DOWN"
                            bool bullMuted = trendMode != "Off" and nasTrendState != "UP"
                            bool bullHidden = trendMode == "Hide counter-trend" and bullCounter
                            if bullHidden
                                debugSignalStatus := debugSignalStatus + " (hidden: counter-trend)"
                                if debugMode and drawingsVisible
                                    label.new(nasTime, drawUsingNASPrices ? nasLow : spxLow, "bull SMT hidden: trend " + nasTrendState,
                                         xloc=xloc.bar_time, style=label.style_label_up, size=size.small, color=color.new(color.gray, 20), textcolor=color.white)
                            // The drawing and the alert share this one validated event.
                            if not bullHidden and enableAlerts and enableBullishAlerts and not array.includes(alertProcessedKeys, eventKey)
                                array.push(alertProcessedKeys, eventKey)
                                while array.size(alertProcessedKeys) > 512
                                    array.shift(alertProcessedKeys)
                                array.push(pendingAlerts, PendingSmt.new(eventKey, true, "5", nasClose, chartConfirmationClose, 0, false, bullNASSwept ? nasTicker : spxTicker, drawUsingNASPrices ? math.min(bullRefNASPrice, bullEndNASPrice) : math.min(bullRefSPXPrice, bullEndSPXPrice), nasTrendState))
                            int lineStartTime = drawUsingNASPrices ? bullRefNASTime : bullRefSPXTime
                            float lineStartPrice = drawUsingNASPrices ? bullRefNASPrice : bullRefSPXPrice
                            float lineEndPrice = drawUsingNASPrices ? bullEndNASPrice : bullEndSPXPrice
                            if not bullHidden and showHistoricalLines and drawingsVisible and showBullishLines
                                DrawSmt drawing = DrawSmt.new(true, bullMuted, nasClose, lineStartTime, lineStartPrice, bullSweepTime, lineEndPrice)
                                f_recordDraw(historicalDraws, pendingDraws, drawing, maximumHistoricalSignals, showOnlyLatest, barstate.ishistory)
                    else if bullDivergedCount > 0
                        debugSignalStatus := "Bullish sweep not confirmed: " + bullReason
                        if debugMode and drawingsVisible
                            label.new(nasTime, drawUsingNASPrices ? nasLow : spxLow, "bull SMT x " + bullReason,
                                 xloc=xloc.bar_time, style=label.style_label_up, size=size.small, color=color.new(color.green, 40), textcolor=color.white)
                // Pending alerts advance only on closed 5M source candles, so the
                // delay counts real 5M candle closes.
                f_processPendingAlerts(pendingAlerts, alertedKeys, nasClose,
                     candleClosesBeforeAlert, enableAlerts, enableBullishAlerts, enableBearishAlerts)
            nasIndex += 1
            spxIndex += 1
        else if nasSource.sourceTime < spxSource.sourceTime
            nasIndex += 1
        else if nasSource.sourceTime > spxSource.sourceTime
            spxIndex += 1
        else if nasSource.sourceClose < spxSource.sourceClose
            nasIndex += 1
        else
            spxIndex += 1
// During initial history processing, retain only the latest N event records
// and create those drawings once at the last historical bar. Live 5M events
// remain queued until the host chart bar confirms, so source closes inside a chart candle are retained.
if barstate.islastconfirmedhistory and array.size(historicalDraws) > 0
    while array.size(historicalDraws) > 0
        DrawSmt historicalDrawing = array.shift(historicalDraws)
        f_renderDraw(historicalDrawing, smtLines, drawnKeys, maximumHistoricalSignals,
             showOnlyLatest, showHistoricalLines, bullishColor, bearishColor, lineTransparency, lineWidth)
// Live SMT lines are drawn on every update (so the line shows up at the same
// moment as the alert) and are kept for good when the chart bar confirms.
if array.size(pendingDraws) > 0
    for drawing in pendingDraws
        f_renderDraw(drawing, smtLines, drawnKeys, maximumHistoricalSignals,
             showOnlyLatest, showHistoricalLines, bullishColor, bearishColor, lineTransparency, lineWidth)
    if barstate.isconfirmed
        array.clear(pendingDraws)
//====================================================
// Optional, low-overhead debug table
//====================================================
var table debugTable = table.new(position.top_right, 2, 17, border_width=1)
if barstate.islast and debugMode
    table.cell(debugTable, 0, 0, "5M SMT Debug", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(debugTable, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(debugTable, 0, 1, "Chart market", text_color=color.white)
    table.cell(debugTable, 1, 1, syminfo.prefix + ":" + syminfo.ticker + (chartIsPepperstone ? "" : " (NOT Pepperstone feed)"), text_color=color.white)
    table.cell(debugTable, 0, 2, "Engine active", text_color=color.white)
    table.cell(debugTable, 1, 2, canRunEngine ? "yes" : "no", text_color=color.white)
    table.cell(debugTable, 0, 3, "Latest " + nasTicker + " H / L", text_color=color.white)
    table.cell(debugTable, 1, 3, f_debugTime(lastNASHighPivotTime) + " / " + f_debugTime(lastNASLowPivotTime), text_color=color.white)
    table.cell(debugTable, 0, 4, "Latest " + spxTicker + " H / L", text_color=color.white)
    table.cell(debugTable, 1, 4, f_debugTime(lastSPXHighPivotTime) + " / " + f_debugTime(lastSPXLowPivotTime), text_color=color.white)
    table.cell(debugTable, 0, 5, "High pivots compared", text_color=color.white)
    table.cell(debugTable, 1, 5, debugHighPair, text_color=color.white)
    table.cell(debugTable, 0, 6, "High pair sync", text_color=color.white)
    table.cell(debugTable, 1, 6, debugHighSync, text_color=color.white)
    table.cell(debugTable, 0, 7, "Low pivots compared", text_color=color.white)
    table.cell(debugTable, 1, 7, debugLowPair, text_color=color.white)
    table.cell(debugTable, 0, 8, "Low pair sync", text_color=color.white)
    table.cell(debugTable, 1, 8, debugLowSync, text_color=color.white)
    table.cell(debugTable, 0, 9, nasTicker + " / " + spxTicker + " pivots", text_color=color.white)
    table.cell(debugTable, 1, 9, str.tostring(nasPivotCount) + " / " + str.tostring(spxPivotCount), text_color=color.white)
    table.cell(debugTable, 0, 10, "Matched H / L", text_color=color.white)
    table.cell(debugTable, 1, 10, str.tostring(matchedHighCount) + " / " + str.tostring(matchedLowCount), text_color=color.white)
    table.cell(debugTable, 0, 11, "Bull / bear SMT", text_color=color.white)
    table.cell(debugTable, 1, 11, str.tostring(bullishSignalCount) + " / " + str.tostring(bearishSignalCount), text_color=color.white)
    table.cell(debugTable, 0, 12, "Latest SMT validation", text_color=color.white)
    table.cell(debugTable, 1, 12, debugSignalStatus, text_color=color.white)
    table.cell(debugTable, 0, 13, "Alert state", text_color=color.white)
    table.cell(debugTable, 1, 13, debugAlertStatus, text_color=color.white)
    table.cell(debugTable, 0, 14, "Alert reason", text_color=color.white)
    table.cell(debugTable, 1, 14, debugAlertReason, text_color=color.white)
    table.cell(debugTable, 0, 15, "Last source close (Oslo)", text_color=color.white)
    table.cell(debugTable, 1, 15, na(lastDebugSourceClose) ? "—" : str.format_time(lastDebugSourceClose, "MM-dd HH:mm", "Europe/Oslo"), text_color=color.white)
    table.cell(debugTable, 0, 16, "Break resets", text_color=color.white)
    table.cell(debugTable, 1, 16, str.tostring(breakResetCount) + (na(lastBreakTime) ? "" : " (last " + f_debugTime(lastBreakTime) + ")"), text_color=color.white)
// The signal is only valid for MT5 when it comes from the same broker feed.
var table feedWarning = table.new(position.bottom_right, 1, 1)
if barstate.islast and not chartIsPepperstone
    table.cell(feedWarning, 0, 0, "Chart is not on the PEPPERSTONE feed. Prices will not match the MT5 account.",
         text_color=color.white, bgcolor=color.new(color.red, 20))
